<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══ Kitty world: The Risograph Press  (id: riso, Light) ═══ -->

  <Color x:Key="SystemAccentColor">#FFFF4E8B</Color>
  <Color x:Key="SystemAccentColorDark1">#FFE0457A</Color>
  <Color x:Key="SystemAccentColorDark2">#FFC23B6A</Color>
  <Color x:Key="SystemAccentColorDark3">#FFA33259</Color>
  <Color x:Key="SystemAccentColorLight1">#FFFF6EA0</Color>
  <Color x:Key="SystemAccentColorLight2">#FFFF8EB5</Color>
  <Color x:Key="SystemAccentColorLight3">#FFFFAECA</Color>

  <!-- ground -->
  <Color x:Key="GroundA">#F6F1E7</Color>
  <Color x:Key="GroundB">#F1E9DA</Color>
  <Color x:Key="GroundC">#ECE2CE</Color>

  <!-- aurora identity -->
  <SolidColorBrush x:Key="AuroraSakuraColor" Color="#FF4E8B" />
  <SolidColorBrush x:Key="AuroraIrisColor" Color="#3D5A9E" />
  <SolidColorBrush x:Key="AuroraMintColor" Color="#7A5AA8" />
  <SolidColorBrush x:Key="AuroraPeachColor" Color="#E0B84A" />

  <!-- glass / surfaces -->
  <Color x:Key="GlassColor">#D9FCF9F2</Color>
  <Color x:Key="GlassStrongColor">#F2FCF9F2</Color>
  <Color x:Key="GlassHoverColor">#FFFCF9F2</Color>
  <Color x:Key="GlassDeepColor">#1A000000</Color>
  <Color x:Key="GlassFillTop">#24FCF9F2</Color>
  <Color x:Key="GlassFillBottom">#0AFCF9F2</Color>
  <Color x:Key="LineColor">#D8CDB6</Color>
  <Color x:Key="LineStrongColor">#BFB198</Color>
  <Color x:Key="LineFaintColor">#E7DECB</Color>
  <Color x:Key="EdgeColor">#FFFFFF</Color>
  <Color x:Key="WellColor">#FBF7EF</Color>
  <Color x:Key="WellHoverColor">#FFFFFF</Color>

  <!-- ink -->
  <Color x:Key="InkColor">#17141C</Color>
  <Color x:Key="InkMutedColor">#4A4358</Color>
  <Color x:Key="InkFaintColor">#837A8E</Color>
  <Color x:Key="InkGhostColor">#BCB3C0</Color>
  <Color x:Key="OnAccentColor">#FFFFFF</Color>
  <Color x:Key="OnChromeColor">#FFFFFF</Color>

  <!-- accents -->
  <Color x:Key="AccentColor">#FF4E8B</Color>
  <Color x:Key="AccentDeepColor">#E0326C</Color>
  <Color x:Key="AccentSoftColor">#FF7AA8</Color>
  <Color x:Key="AccentWashColor">#2EFF4E8B</Color>
  <Color x:Key="AccentWashFaint">#16FF4E8B</Color>
  <Color x:Key="AccentClear">#00FF4E8B</Color>
  <Color x:Key="SecondColor">#3D5A9E</Color>
  <Color x:Key="SecondDeepColor">#2C4480</Color>
  <Color x:Key="SecondSoftColor">#6B85BE</Color>
  <Color x:Key="SecondWashColor">#2E3D5A9E</Color>
  <Color x:Key="SecondWashFaint">#143D5A9E</Color>
  <Color x:Key="SecondClear">#003D5A9E</Color>
  <Color x:Key="ThirdColor">#7A5AA8</Color>
  <Color x:Key="ThirdDeepColor">#614488</Color>
  <Color x:Key="ThirdWashColor">#2E7A5AA8</Color>
  <Color x:Key="ThirdWashFaint">#147A5AA8</Color>
  <Color x:Key="ThirdClear">#007A5AA8</Color>
  <Color x:Key="Accent4Wash">#24E0B84A</Color>
  <Color x:Key="Accent4WashFaint">#12E0B84A</Color>
  <Color x:Key="Accent4Clear">#00E0B84A</Color>
  <Color x:Key="GoldColor">#C08A2E</Color>
  <Color x:Key="GoldDeepColor">#A0711E</Color>
  <Color x:Key="GoldWashColor">#24C08A2E</Color>
  <Color x:Key="GoldClear">#00C08A2E</Color>

  <!-- signals -->
  <Color x:Key="AmberColor">#C77A1A</Color>
  <Color x:Key="AmberWashColor">#24C77A1A</Color>
  <Color x:Key="DangerColor">#D2352B</Color>
  <Color x:Key="DangerWashColor">#24D2352B</Color>
  <Color x:Key="LedColor">#3D5A9E</Color>

  <!-- atmosphere -->
  <Color x:Key="VignetteInnerColor">#00FFFFFF</Color>
  <Color x:Key="VignetteOuterColor">#14000000</Color>
  <Color x:Key="HearthAColor">#00000000</Color>
  <Color x:Key="HearthBColor">#00000000</Color>
  <Color x:Key="HearthCColor">#00000000</Color>
  <Color x:Key="PillAColor">#FF7AA8</Color>
  <Color x:Key="PillBColor">#FF4E8B</Color>
  <Color x:Key="PillCColor">#E0326C</Color>
  <Color x:Key="PillTextAColor">#FFFFFF</Color>
  <Color x:Key="PillTextBColor">#FFFFFF</Color>
  <Color x:Key="MedallionAColor">#14000000</Color>
  <Color x:Key="MedallionBColor">#08000000</Color>
  <Color x:Key="SheenColor">#59FFFFFF</Color>
  <Color x:Key="SheenClear">#00FFFFFF</Color>
  <Color x:Key="HoverBloomColor">#26FF4E8B</Color>
  <Color x:Key="SkullColor">#10000000</Color>
  <Color x:Key="SkullStrongColor">#1C000000</Color>

  <!-- type: one voice per world, same token names everywhere -->
  <FontFamily x:Key="WordmarkFont">avares://Kitty/Assets/Fonts/Ballet.ttf#Ballet 28pt</FontFamily>
  <FontFamily x:Key="SerifFont">avares://Kitty/Assets/Fonts/Anton-Regular.ttf#Anton</FontFamily>
  <FontFamily x:Key="TitleFont">avares://Kitty/Assets/Fonts/Anton-Regular.ttf#Anton</FontFamily>
  <FontFamily x:Key="SignatureFont">avares://Kitty/Assets/Fonts/Rochester.ttf#Rochester</FontFamily>
  <FontFamily x:Key="ScriptFont">avares://Kitty/Assets/Fonts/Ruthie.ttf#Ruthie</FontFamily>
  <FontFamily x:Key="FancyFont">avares://Kitty/Assets/Fonts/Stalemate.ttf#Stalemate</FontFamily>
  <FontFamily x:Key="DisplayFont">avares://Kitty/Assets/Fonts/Anton-Regular.ttf#Anton</FontFamily>
  <FontFamily x:Key="RoundedFont">avares://Kitty/Assets/Fonts/IBMPlexMono-Medium.ttf#IBM Plex Mono Medium</FontFamily>
  <FontFamily x:Key="NumeralFont">avares://Kitty/Assets/Fonts/Anton-Regular.ttf#Anton</FontFamily>
  <FontFamily x:Key="MonoFont">avares://Kitty/Assets/Fonts/IBMPlexMono-Regular.ttf#IBM Plex Mono</FontFamily>
  <FontFamily x:Key="MonoMediumFont">avares://Kitty/Assets/Fonts/IBMPlexMono-Medium.ttf#IBM Plex Mono Medium</FontFamily>
  <FontFamily x:Key="BodyFont">Lucida Sans Unicode</FontFamily>

  <!-- density + character -->
  <CornerRadius x:Key="CardRadius">2</CornerRadius>
  <CornerRadius x:Key="ChipRadius">2</CornerRadius>
  <CornerRadius x:Key="FieldRadius">2</CornerRadius>
  <Thickness x:Key="CardPad">18,12,12,12</Thickness>
  <x:Double x:Key="RowSpace">8</x:Double>
  <x:Double x:Key="HeaderSize">40</x:Double>
  <x:Double x:Key="DisplaySize">40</x:Double>
  <x:Double x:Key="TitleSize">24</x:Double>
  <x:Double x:Key="BodySize">12.5</x:Double>
  <x:Double x:Key="MicroSize">9.5</x:Double>
  <x:Double x:Key="MicroTrack">1.8</x:Double>
  <x:Double x:Key="AtmosphereOpacity">0.25</x:Double>
  <BoxShadows x:Key="CardShadow">0 10 26 -18 #59000000</BoxShadows>
  <BoxShadows x:Key="AccentGlow">0 8 22 -6 #55FF4E8B</BoxShadows>

</ResourceDictionary>
